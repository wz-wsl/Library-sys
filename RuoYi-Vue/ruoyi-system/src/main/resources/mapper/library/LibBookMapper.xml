<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.library.mapper.LibBookMapper">

    <!-- 列名 → 字段名 对照表 -->
    <resultMap type="LibBook" id="LibBookResult">
        <id     property="bookId"      column="book_id"      />
        <result property="categoryId"  column="category_id"  />
        <result property="isbn"        column="isbn"         />
        <result property="bookName"    column="book_name"    />
        <result property="author"      column="author"       />
        <result property="publisher"   column="publisher"    />
        <result property="coverImage"  column="cover_image"  />
        <result property="totalCount"  column="total_count"  />
        <result property="stockCount"  column="stock_count"  />
        <result property="status"      column="status"       />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
    </resultMap>

    <sql id="selectLibBookVo">
        select book_id, category_id, isbn, book_name, author, publisher, cover_image, total_count, stock_count,
               status, create_by, create_time, update_by, update_time, remark
        from lib_book
    </sql>

    <!-- 查询图书列表 -->
    <select id="selectLibBookList" parameterType="LibBook" resultMap="LibBookResult">
        <include refid="selectLibBookVo"/>
        <where>
            <if test="bookName != null and bookName != ''">
                AND book_name like concat('%', #{bookName}, '%')
            </if>
            <if test="author != null and author != ''">
                AND author like concat('%', #{author}, '%')
            </if>
            <if test="categoryId != null">
                AND category_id = #{categoryId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <!-- 新增图书 -->
    <insert id="insertLibBook" parameterType="LibBook" useGeneratedKeys="true" keyProperty="bookId">
        insert into lib_book(
            <if test="categoryId != null">category_id,</if>
            <if test="isbn != null and isbn != ''">isbn,</if>
            <if test="bookName != null and bookName != ''">book_name,</if>
            <if test="author != null and author != ''">author,</if>
            <if test="publisher != null and publisher != ''">publisher,</if>
            <if test="coverImage != null and coverImage != ''">cover_image,</if>
            <if test="totalCount != null">total_count,</if>
            <if test="stockCount != null">stock_count,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="categoryId != null">#{categoryId},</if>
            <if test="isbn != null and isbn != ''">#{isbn},</if>
            <if test="bookName != null and bookName != ''">#{bookName},</if>
            <if test="author != null and author != ''">#{author},</if>
            <if test="publisher != null and publisher != ''">#{publisher},</if>
            <if test="coverImage != null and coverImage != ''">#{coverImage},</if>
            <if test="totalCount != null">#{totalCount},</if>
            <if test="stockCount != null">#{stockCount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <select id="selectLibBookById" parameterType="Long" resultMap="LibBookResult">
        <include refid="selectLibBookVo"/>
        where book_id = #{bookId}
    </select>

    <update id="updateLibBook" parameterType="LibBook">
        update  lib_book
        <set>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="bookName != null and bookName != ''">book_name = #{bookName},</if>
            <if test="author != null">author = #{author},</if>
            <if test="publisher != null">publisher = #{publisher},</if>
            <if test="isbn != null">isbn = #{isbn},</if>
            <if test="coverImage != null">cover_image = #{coverImage},</if>
            <if test="totalCount != null">total_count = #{totalCount},</if>
            <if test="stockCount != null">stock_count = #{stockCount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where book_id = #{bookId}
    </update>
    <delete id="deleteLibBookByIds" parameterType="Long">
        delete from lib_book where book_id in
        <foreach collection="array" item="bookId" open="(" close=")" separator=",">
            #{bookId}
        </foreach>
    </delete>
</mapper>
